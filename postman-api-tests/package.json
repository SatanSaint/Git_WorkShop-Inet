{
  "name": "postman-api-tests",
  "version": "1.0.0",
  "description": "Generate and run Vitest API tests from a Postman collection",
  "scripts": {
    "fetch": "tsx tools/fetch-collection.ts",
    "generate": "tsx tools/generate-tests.ts",
    "fetch:generate": "npm run fetch && npm run generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
