# ============================================================
# Environment Variables for postman-api-tests
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับระบบของคุณ
# Copy this file to .env and fill in your values
# ============================================================

# ─── Required for running tests ─────────────────────────────
# Base URL ของ API ที่ต้องการทดสอบ
BASE_URL=https://your-api.example.com

# Bearer token สำหรับ Authorization header (ถ้าไม่มีให้ว่างไว้)
TOKEN=

# ─── Required for fetching collection from Postman API ──────
# API key จาก Postman: https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=

# Workspace UUID (ดูจาก URL ใน Postman เช่น https://app.getpostman.com/workspace/<UUID>)
WORKSPACE_ID=9f554d95-7dd6-415f-a35d-dcc24e35a09b

# Collection UID (ถ้าทราบแล้ว จะข้ามขั้นตอนดึง workspace)
# ดูได้จาก Postman: right-click collection → View Documentation หรือดูใน URL
COLLECTION_UID=
